import os
import time
import subprocess
import threading
import ctypes

# Audio Payload POC (.pyz) - PayloadParadise
# FOR EDUCATIONAL PURPOSES ONLY.

YOUTUBE_URL = "https://www.youtube.com/watch?v=dQw4w9WgXcQ?autoplay=1"

def max_out_volume():
    VK_VOLUME_UP = 0xAF
    for _ in range(50):
        ctypes.windll.user32.keybd_event(VK_VOLUME_UP, 0, 0, 0)
        ctypes.windll.user32.keybd_event(VK_VOLUME_UP, 0, 2, 0)
        time.sleep(0.01)

def play_annoying_beeps():
    patterns = [(2500, 200), (3000, 200), (2500, 200), (3000, 200),
                (3500, 100), (3500, 100), (3500, 100), (3500, 100)]
    for freq, duration in patterns:
        ctypes.windll.kernel32.Beep(freq, duration)
        time.sleep(0.05)

def text_to_speech():
    message = "Warning. System compromised. You should not run untrusted scripts."
    ps_script = f"Add-Type -AssemblyName System.Speech; $synth = New-Object System.Speech.Synthesis.SpeechSynthesizer; $synth.Speak('{message}');"
    try:
        subprocess.run(["powershell", "-Command", ps_script], creationflags=subprocess.CREATE_NO_WINDOW)
    except Exception:
        pass

def open_youtube_video():
    try:
        os.startfile(YOUTUBE_URL)
    except AttributeError:
        subprocess.run(["cmd", "/c", "start", YOUTUBE_URL], creationflags=subprocess.CREATE_NO_WINDOW)
    except Exception:
        pass

if __name__ == "__main__":
    max_out_volume()
    play_annoying_beeps()
    
    tts_thread = threading.Thread(target=text_to_speech)
    tts_thread.start()
    
    open_youtube_video()
    tts_thread.join()
